# =========================================
# KiCad
# =========================================

# Backups / autosaves
*.bak
*.kicad_prl
*.kicad_pro-bak
*.kicad_sch-bak
*.kicad_pcb-bak
*-backups/
_autosave-*

# Lock files
~*.lck
*.lck

# Cache / generated files
fp-info-cache
*.kicad_wks-bak

# Older KiCad cache files
*-cache.lib

# =========================================
# LTspice
# =========================================

# Waveform / simulation output
*.raw
*.log
*.fft

# Operating point / netlist / generated files
*.net
*.op.raw

# Temporary files
*.tmp
*.temp

# Keep LTspice source files:
# *.asc
# *.asy
# *.lib
# *.sub
# *.cir

# =========================================
# SPICE / simulation misc
# =========================================

*.out
*.tr0
*.ac0
*.sw0

# =========================================
# OS junk
# =========================================

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# =========================================
# Editors / IDEs
# =========================================

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/

*.swp
*.swo
*~

# =========================================
# Misc project junk
# =========================================

*.zip
*.7z
*.rar

# Temporary exports
exports/
temp/
tmp/

# =========================================
# Fusion 360 / CAD
# =========================================

# Temporary / backup files
*.bak
*.tmp
*.temp
~$*

# Fusion 360 local cache / recovery-type files
*.f3d~
*.f3z~

# Generic CAD autosave/recovery
*.autosave
*.recover

# Render / mesh generation temp files
*.mesh
*.cache

# Optional: ignore generated manufacturing exports
# Uncomment if you only want to track source CAD
# *.stl
# *.3mf
# *.dxf
# *.step
# *.stp

# OS metadata often created around CAD files
.DS_Store
Thumbs.db
Desktop.ini

# =========================================
# Obsidian
# =========================================

.obsidian/*
